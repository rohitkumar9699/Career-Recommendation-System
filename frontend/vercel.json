{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://REPLACE_WITH_BACKEND_PROJECT.vercel.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
